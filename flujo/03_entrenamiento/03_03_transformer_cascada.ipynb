    "    cascade_result=run_with_progress('Transformer en cascada',train_neural_experiment,DATA,OUTPUT_ROOT,experiment='cascade',device=DEVICE,safe_to_damage_ratio=SAFE_TO_DAMAGE_RATIO,progress_unit='etapa')\n",
