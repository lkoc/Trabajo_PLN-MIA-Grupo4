    "COLAB_EXPECTED_CORE_SHA256 = \"933fc7672c801d9a68630b3452fe29098cd24b063e9ea1983d5d6a6746b1b3f3\"\n",
    "IN_COLAB = importlib.util.find_spec(\"google.colab\") is not None\n",
